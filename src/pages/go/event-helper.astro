---
// Outbound hop → The Event Helper. noindex, not in the sitemap.
// Change the destination in src/data/partners.js AND here (they must match).
import { PARTNERS } from '../../data/partners.js';
const url = PARTNERS['event-helper'].href;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <title>Redirecting to our partner quote page — CoverToday</title>
    <style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;color:#10263D;text-align:center;padding:24px}a{color:#0B1F4A}</style>
  </head>
  <body>
    <div>
      <p>Taking you to our partner’s secure quote page…</p>
      <p><a href={url} rel="noopener sponsored">Continue &rarr;</a> &middot; <a href="/event-insurance">Back to CoverToday</a></p>
    </div>
    <script is:inline define:vars={{ url }}>window.location.replace(url);</script>
  </body>
</html>
