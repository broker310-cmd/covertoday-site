---
import Base from '../../layouts/Base.astro';
import { resources } from '../../i18n/content-standalone.js';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' }, props: { c: resources.ru } },
  ];
}
const { c } = Astro.props;
// Russian articles — real RU content, not a fallback to the English list.
const posts = (await getCollection('blog-ru')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
---
<Base title={c.metaTitle} description={c.metaDesc}>
  <section class="hero"><div class="wrap">
    <h1>{c.h1}</h1>
    <p class="sub">{c.sub}</p>
  </div></section>
  <section><div class="wrap">
    {c.tools && (
      <>
        <div class="eyebrow">{c.toolsEyebrow}</div>
        <h2 class="sec">{c.toolsTitle}</h2>
        <div class="grid grid-3" style="margin-bottom:40px">
          {c.tools.map((tl) => (<a class="card" href={tl.href}><div class="eyebrow" style="margin-bottom:6px">{tl.k}</div><h3>{tl.t}</h3><p>{tl.d}</p></a>))}
        </div>
      </>
    )}
    {posts.length > 0 && (
      <>
        <div class="eyebrow">Статьи на русском</div>
        <h2 class="sec">Гайды и разборы</h2>
        <div class="grid grid-3" style="margin-bottom:40px">
          {posts.map((post) => (
            <a class="card" href={`/ru/resources/${post.slug}`} style="text-decoration:none">
              <div class="eyebrow" style="margin-bottom:6px">{post.data.category}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </>
    )}
    <div class="eyebrow">{c.eyebrow}</div>
    <h2 class="sec">{c.title}</h2>
    <div class="grid grid-3">
      {c.topics.map((tp) => (<div class="card"><h3>{tp.t}</h3><p>{tp.d}</p></div>))}
    </div>
    <p class="lead" style="margin-top:24px" set:html={c.cta}></p>
  </div></section>
</Base>
